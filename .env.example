# The core lab needs NO .env and NO API key — it runs entirely on the offline
# fake model. This file matters only if you enable the OPTIONAL real-LLM engine.
#
# Copy to .env and fill in. Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Optional: override the model id (mirrors Interchange).
# PLAYGROUND_MODEL=claude-haiku-4-5-20251001
